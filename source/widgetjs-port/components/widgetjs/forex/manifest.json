{
  "schemaVersion": 1,
  "id": "local.souldesk.widgetjs.forex",
  "name": "汇率换算",
  "version": "0.1.5",
  "hostApiMajor": 1,
  "loadCheck": 1,
  "entry": "dist/index.html",
  "defaultSize": {
    "width": 320,
    "height": 188
  },
  "minSize": {
    "width": 240,
    "height": 184
  },
  "capabilities": [
    "storage.instance",
    "content.source.forex"
  ],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "currencies",
      "background",
      "foreground",
      "radius"
    ],
    "properties": {
      "from": {
        "type": "string",
        "title": "旧版来源币种",
        "maxLength": 3
      },
      "to": {
        "type": "string",
        "title": "旧版目标币种",
        "maxLength": 3
      },
      "currencies": {
        "type": "string",
        "title": "币种列表",
        "maxLength": 8192,
        "default": ""
      },
      "background": {
        "type": "string",
        "title": "背景颜色",
        "maxLength": 7,
        "default": "#364052"
      },
      "foreground": {
        "type": "string",
        "title": "文字颜色",
        "maxLength": 7,
        "default": "#ffffff"
      },
      "radius": {
        "type": "integer",
        "title": "圆角",
        "minimum": 0,
        "maximum": 40,
        "default": 16
      }
    }
  }
}
