{
  "schemaVersion": 1,
  "id": "local.souldesk.market",
  "name": "币安行情与价格警报",
  "version": "0.3.6",
  "hostApiMajor": 1,
  "loadCheck": 1,
  "entry": "dist/index.html",
  "defaultSize": {
    "width": 430,
    "height": 460
  },
  "minSize": {
    "width": 320,
    "height": 260
  },
  "capabilities": [
    "storage.instance",
    "market.read",
    "market.chart",
    "alerts.manage"
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 60,
        "default": "市场观察"
      },
      "layout": { "type": "string", "maxLength": 4, "default": "list" },
      "rangeHours": { "type": "integer", "minimum": 1, "maximum": 168, "default": 4 },
      "maPeriods": { "type": "string", "maxLength": 30, "default": "5,10,30" }
    },
    "additionalProperties": false
  }
}
